# Variables de la app Mi Ruta VIIGO (los valores reales van en .env.local y en Vercel).

# Públicas: van dentro de la app; las protege la seguridad por fila (RLS) de Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://yobpyjhaeofotyzwfias.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secretas: solo en Vercel (Settings → Environment Variables). Nunca en el código ni en el chat.
SUPABASE_SECRET_KEY=sb_secret_...
GOOGLE_CLIENT_ID=....apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
